# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Anthropic API key — used for resume tailoring (Phase 6) and cover letter generation (Phase 7)
ANTHROPIC_API_KEY=

# Adzuna API credentials — used for job fetching (Phase 2). Free tier at developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs API key — optional, used if we add federal/security-adjacent role search (Phase 2)
USAJOBS_API_KEY=
